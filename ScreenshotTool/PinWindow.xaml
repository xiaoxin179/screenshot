<Window x:Class="ScreenshotTool.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" SizeToContent="WidthAndHeight" PreviewMouseWheel="PinWindowMouseWheel">
  <Border x:Name="Card" Background="#FEFDFC" BorderBrush="#D8D0C6" BorderThickness="1" CornerRadius="10" Padding="5"
          SnapsToDevicePixels="True" MouseLeftButtonDown="CardMouseLeftButtonDown">
    <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.3" Color="#40342D"/></Border.Effect>
    <Grid>
      <Image x:Name="PinnedImage" Stretch="Fill" ClipToBounds="True"/>
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Background="#FFFDFC" BorderBrush="#E3DCD4" BorderThickness="1" CornerRadius="8">
        <Button Content="×" Width="28" Height="28" FontSize="20" FontWeight="Light" Foreground="#B85E59" Background="Transparent" BorderBrush="Transparent" Click="CloseClick" ToolTip="关闭贴图" Cursor="Hand"/>
      </Border>
    </Grid>
  </Border>
</Window>
