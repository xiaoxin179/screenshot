<Window x:Class="ScreenshotTool.SelectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Snaply · 选区截图" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" Cursor="Cross" UseLayoutRounding="True">
 <Window.Resources>
  <Style x:Key="ToolButton" TargetType="Button">
   <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="9,0"/><Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="#443D38"/><Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#E5DED4"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Canvas x:Name="Overlay" Background="Transparent">
  <Image x:Name="ScreenImage" Stretch="Fill" IsHitTestVisible="False"/>
  <Rectangle x:Name="DimTop" Fill="#7A302B27" IsHitTestVisible="False"/><Rectangle x:Name="DimLeft" Fill="#7A302B27" IsHitTestVisible="False"/>
  <Rectangle x:Name="DimRight" Fill="#7A302B27" IsHitTestVisible="False"/><Rectangle x:Name="DimBottom" Fill="#7A302B27" IsHitTestVisible="False"/>
  <Image x:Name="AnnotationPreview" Stretch="Fill" IsHitTestVisible="False" Canvas.ZIndex="4"/>
  <Rectangle x:Name="SelectionBorder" Stroke="#3A9A7F" StrokeThickness="1" Visibility="Collapsed" IsHitTestVisible="False" Canvas.ZIndex="5"/>
  <TextBox x:Name="TextEditor" FontFamily="Microsoft YaHei UI" Visibility="Collapsed" AcceptsReturn="True" TextWrapping="Wrap" Background="#FFFDF8" Foreground="#443D38" Padding="5" BorderBrush="#3A9A7F" BorderThickness="1" Canvas.ZIndex="7" PreviewKeyDown="EditorKeyDown"/>
  <Border x:Name="Toolbar" Background="#FEFDFC" BorderBrush="#DED7CF" BorderThickness="1" CornerRadius="11" Padding="8" Visibility="Collapsed" Canvas.ZIndex="10">
   <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.22" Color="#493C33"/></Border.Effect>
   <StackPanel Width="690">
    <WrapPanel x:Name="ToolsPanel">
     <Button Style="{StaticResource ToolButton}" Content="矩形" Tag="Rectangle" Click="ToolClick"/>
     <Button Style="{StaticResource ToolButton}" Content="椭圆" Tag="Ellipse" Click="ToolClick" ToolTip="按住 Shift 绘制正圆"/>
     <Button Style="{StaticResource ToolButton}" Content="直线" Tag="Line" Click="ToolClick" ToolTip="按住 Shift 约束水平或垂直"/>
     <Button Style="{StaticResource ToolButton}" Content="箭头" Tag="Arrow" Click="ToolClick"/>
     <Button Style="{StaticResource ToolButton}" Content="画笔" Tag="Pen" Click="ToolClick"/>
     <Button Style="{StaticResource ToolButton}" Content="文字" Tag="Text" Click="ToolClick"/>
     <Button Style="{StaticResource ToolButton}" Content="框选打码" Tag="MosaicRectangle" Click="ToolClick"/>
     <Button Style="{StaticResource ToolButton}" Content="涂抹打码" Tag="MosaicBrush" Click="ToolClick"/>
     <Button Style="{StaticResource ToolButton}" Content="高亮" Tag="Highlight" Click="ToolClick"/>
     <Button Style="{StaticResource ToolButton}" Content="标签" Tag="Label" Click="ToolClick"/>
     <Button Style="{StaticResource ToolButton}" Content="水印" Tag="Watermark" Click="ToolClick"/>
    </WrapPanel>
    <WrapPanel Margin="4,5,4,4">
     <TextBlock Text="颜色" VerticalAlignment="Center" Margin="0,0,5,0"/>
     <ComboBox x:Name="ColorPicker" Width="76" SelectionChanged="StyleChanged">
      <ComboBoxItem Content="红色" Tag="#E34D59"/><ComboBoxItem Content="橙色" Tag="#ECA43C"/><ComboBoxItem Content="绿色" Tag="#2E8570"/>
      <ComboBoxItem Content="蓝色" Tag="#397ADB"/><ComboBoxItem Content="黑色" Tag="#202020"/><ComboBoxItem Content="白色" Tag="#FFFFFF"/>
     </ComboBox>
     <TextBlock Text="粗细" VerticalAlignment="Center" Margin="12,0,4,0"/><Slider x:Name="WidthPicker" Width="70" Minimum="1" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderChanged"/>
     <TextBlock Text="字号" VerticalAlignment="Center" Margin="12,0,4,0"/><Slider x:Name="FontPicker" Width="80" Minimum="12" Maximum="72" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="SliderChanged"/>
     <TextBlock Text="水印不透明度" VerticalAlignment="Center" Margin="12,0,4,0"/><Slider x:Name="OpacityPicker" Width="75" Minimum="10" Maximum="100" ValueChanged="SliderChanged"/>
    </WrapPanel>
    <TextBlock x:Name="StatusText" Foreground="#766B60" Margin="4,3" TextTrimming="CharacterEllipsis" Text="拖动选区"/>
    <WrapPanel>
     <Button Style="{StaticResource ToolButton}" Content="长截图" Tag="scroll" Click="ToolClick"/>
     <Button x:Name="UndoButton" Style="{StaticResource ToolButton}" Content="撤销" Tag="undo" Click="ToolClick" ToolTip="Ctrl+Z"/>
     <Button x:Name="RedoButton" Style="{StaticResource ToolButton}" Content="重做" Tag="redo" Click="ToolClick" ToolTip="Ctrl+Y"/>
     <Button Style="{StaticResource ToolButton}" Content="保存" Tag="save" Click="ToolClick" ToolTip="Ctrl+S"/>
     <Button Style="{StaticResource ToolButton}" Content="贴图" Tag="pin" Click="ToolClick"/>
     <Button Style="{StaticResource ToolButton}" Content="取消" Tag="cancel" Click="ToolClick" Foreground="#C56862" ToolTip="Esc"/>
     <Button Style="{StaticResource ToolButton}" Tag="confirm" Click="ToolClick" Background="#2E8570" ToolTip="完成并复制 (Enter)">
      <StackPanel Orientation="Horizontal"><Path Data="M 1,7 L 5,11 L 13,1" Stroke="White" StrokeThickness="2" Width="15" Height="14" Margin="0,0,6,0"/><TextBlock Text="完成" Foreground="White"/></StackPanel>
     </Button>
    </WrapPanel>
   </StackPanel>
  </Border>
 </Canvas>
</Window>
