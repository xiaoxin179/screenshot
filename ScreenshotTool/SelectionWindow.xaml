<Window x:Class="ScreenshotTool.SelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True" Cursor="Cross" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="Height" Value="34"/><Setter Property="MinWidth" Value="36"/><Setter Property="Padding" Value="9,0"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="#443D38"/><Setter Property="FontSize" Value="16"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonRoot" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonRoot" Property="Background" Value="#EEE8E1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonRoot" Property="Background" Value="#DED6CD"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Canvas x:Name="Overlay" Background="Transparent">
    <Image x:Name="ScreenImage" Stretch="Fill" IsHitTestVisible="False"/>
    <Rectangle x:Name="DimTop" Fill="#7A302B27" IsHitTestVisible="False"/>
    <Rectangle x:Name="DimLeft" Fill="#7A302B27" IsHitTestVisible="False"/>
    <Rectangle x:Name="DimRight" Fill="#7A302B27" IsHitTestVisible="False"/>
    <Rectangle x:Name="DimBottom" Fill="#7A302B27" IsHitTestVisible="False"/>
    <Canvas x:Name="AnnotationLayer" IsHitTestVisible="False" Canvas.ZIndex="4"/>
    <Rectangle x:Name="SelectionBorder" Fill="Transparent" Stroke="#3A9A7F" StrokeThickness="2" Visibility="Collapsed" IsHitTestVisible="False" Canvas.ZIndex="5"/>
    <Border x:Name="Toolbar" Background="#FEFDFC" BorderBrush="#DED7CF" BorderThickness="1" CornerRadius="11" Padding="5" Visibility="Collapsed" Canvas.ZIndex="10">
      <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.22" Color="#493C33"/></Border.Effect>
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource ToolButton}" Content="□" Tag="rect" Click="ToolClick" ToolTip="矩形标注"/>
        <Button Style="{StaticResource ToolButton}" Content="╱" Tag="pen" Click="ToolClick" ToolTip="画笔" FontWeight="Bold"/>
        <Separator Width="1" Margin="5,6" Background="#E0D8D0"/>
        <Button Style="{StaticResource ToolButton}" Content="⌖" Tag="pin" Click="ToolClick" ToolTip="贴图到桌面"/>
        <Separator Width="1" Margin="5,6" Background="#E0D8D0"/>
        <Button Style="{StaticResource ToolButton}" Content="×" Tag="cancel" Click="ToolClick" PreviewMouseLeftButtonUp="ActionButtonMouseUp" ToolTip="取消 (Esc)" Foreground="#C56862" FontSize="21"/>
        <Button Content="✓" Tag="confirm" Click="ToolClick" PreviewMouseLeftButtonUp="ActionButtonMouseUp" Width="40" Height="34" Margin="4,0,0,0" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Background="#2E8570" BorderBrush="#2E8570" Cursor="Hand" ToolTip="完成截图 (Enter)">
          <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="ConfirmRoot" Background="{TemplateBinding Background}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ConfirmRoot" Property="Background" Value="#246F5E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
        </Button>
      </StackPanel>
    </Border>
  </Canvas>
</Window>
